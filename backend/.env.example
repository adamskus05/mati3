# Copy this to .env and fill in your API keys

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+asyncpg://odds:odds@localhost:5432/oddsdb
DATABASE_URL_SYNC=postgresql://odds:odds@localhost:5432/oddsdb

# API-Football via RapidAPI — free tier: 100 req/day
# Sign up at: https://rapidapi.com/api-sports/api/api-football
API_FOOTBALL_KEY=your_rapidapi_key_here

# The Odds API — free tier: 500 req/month
# Sign up at: https://the-odds-api.com
ODDS_API_KEY=your_odds_api_key_here

# Value bet detection settings
MIN_EDGE_PERCENT=3.0
MIN_MATCHES_FOR_ESTIMATE=5
